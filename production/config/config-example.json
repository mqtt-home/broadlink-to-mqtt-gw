                "tv_power": "JgBQAAABKZITExM3EhMTExMTExMTExMUEhMTExMTNxM3EzcTNxM3EzcTNxM3ExMTExMTExMTExMTExMTExMTNxM3EzcTNxM3EzcTNxM3EwAF"
            }
        }
    ],
    "loglevel": "info"
}
